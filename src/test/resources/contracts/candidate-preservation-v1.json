  "defaultCandidate": {
    "id": "11111111-1111-4111-8111-111111111111",
    "geometry": "candidate",
    "pathClass": "Tubule",
    "plane": {"z": 0, "t": 0}
  },
  "defaultExisting": {
    "geometry": "positive-overlap",
    "pathClass": "Tubule",
    "plane": {"z": 0, "t": 0},
    "objectType": "detection",
    "attributed": false,
    "administrative": false
  },
  "cases": [
    {
      "name": "enabled-detection-positive-overlap-suppresses",
      "enabled": true,
      "expectedRetained": false,
      "expectedSuppressedCount": 1
    },
    {
      "name": "disabled-keeps-both",
      "enabled": false,
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "annotation-positive-overlap-suppresses",
      "enabled": true,
      "existing": {"objectType": "annotation"},
      "expectedRetained": false,
      "expectedSuppressedCount": 1
    },
    {
      "name": "different-plane-does-not-suppress",
      "enabled": true,
      "existing": {"plane": {"z": 1, "t": 0}},
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "different-timepoint-does-not-suppress",
      "enabled": true,
      "existing": {"plane": {"z": 0, "t": 1}},
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "different-class-does-not-suppress",
      "enabled": true,
      "existing": {"pathClass": "Lumen"},
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "attributed-other-producer-does-not-suppress",
      "enabled": true,
      "existing": {"attributed": true},
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "administrative-object-does-not-suppress",
      "enabled": true,
      "existing": {"objectType": "annotation", "administrative": true},
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "unsupported-object-type-does-not-suppress",
      "enabled": true,
      "existing": {"objectType": "other"},
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "boundary-only-contact-does-not-suppress",
      "enabled": true,
      "existing": {"geometry": "boundary-touch"},
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "disjoint-does-not-suppress",
      "enabled": true,
      "existing": {"geometry": "disjoint"},
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "unclassified-object-does-not-suppress",
      "enabled": true,
      "existing": {"pathClass": null},
      "expectedRetained": true,
      "expectedSuppressedCount": 0
    },
    {
      "name": "multipolygon-positive-overlap-suppresses",
      "enabled": true,
      "candidate": {"geometry": "multi-candidate"},
      "existing": {"geometry": "multi-overlap"},
      "expectedRetained": false,
      "expectedSuppressedCount": 1
    }
  ],
  "multiCandidateCase": {
